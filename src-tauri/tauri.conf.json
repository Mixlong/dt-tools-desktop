{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DT-Tools",
  "version": "0.1.2",
  "identifier": "com.digiwise.dttoolsdesktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3011",
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "DT-Tools",
        "width": 1680,
        "height": 920,
        "minWidth": 1366,
        "minHeight": 1000,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "titleBarStyle": "Overlay",
        "shadow": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "endpoints": [
        "https://bikewise.oss-cn-shenzhen.aliyuncs.com/d-space/dt-tools-desktop/{{target}}/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4REJDRDc0QzI4OTI5MEQKUldRTktZbkNkTTNidUtwTGRmSTFQcGJ0aW5IbnhWLzJpYysweHRyaVFFWE5qMnhyWjhUTWpSemgK"
    }
  }
}
